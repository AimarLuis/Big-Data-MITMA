# =============================================================================
# CONFIGURACIÓN ÚNICA DEL PIPELINE (criterio E1: nada de rutas escritas en el código)
# Formato .env (CLAVE=valor). Lo leen:
#   - los scripts bash de los contenedores Hadoop:  set -a; source config/pipeline.env
#   - el código PySpark:                            src/common.py -> load_config()
# Valores con caracteres especiales para bash (| { }) van entre comillas.
# =============================================================================

# ---- HDFS: zonas del data lake --------------------------------------------
HDFS_URI="hdfs://namenode:9000"
RAW_VIAJES="/raw/mitma/viajes"
RAW_MUNICIPIOS="/raw/mitma/municipios"
RAW_AUX="/raw/mitma/aux"
CURATED="/curated/mitma/viajes"
QUARANTINE="/quarantine/mitma/viajes"
RESULTS="/results/mitma"
TMP_GZ="/tmp/mitma_gz"
# Factor de replicación de lo que escribe Spark. El cliente HDFS de Spark no lee el
# hdfs-site.xml del cluster y usaría su valor por defecto (3): con 2 DataNodes, todos
# los bloques de curated quedarían "under-replicated".
HDFS_REPLICATION="2"

# ---- Datos locales (rutas relativas a la raíz del repo) --------------------
LOCAL_VIAJES="data/raw/viajes"
LOCAL_MUNICIPIOS="data/raw/municipios"
LOCAL_DOWNLOADS="data/downloads"
LOCAL_AUX="data_aux"
EVIDENCIAS="evidencias"

# ---- Descarga (script reproducible) ----------------------------------------
FECHA_INICIO="2022-10-26"
FECHA_FIN="2022-11-01"
URL_VIAJES="https://movilidad-opendata.mitma.es/estudios_basicos/por-municipios/viajes/ficheros-diarios/{ym}/{ymd}_Viajes_municipios.csv.gz"
URL_MUNICIPIOS="https://movilidad-opendata.mitma.es/zonificacion/zonificacion_municipios/nombres_municipios.csv"

# ---- Formato de los datos ---------------------------------------------------
CSV_SEP="|"
DATE_FORMAT="yyyyMMdd"
PARTITION_COLUMN="fecha"

# ---- Calidad de datos ------------------------------------------------------
MAX_BAD_RATIO="0.01"
MAX_UNMATCHED_RATIO="0.01"

# ---- Spark ------------------------------------------------------------------
SPARK_MASTER="spark://spark-master:7077"
SPARK_DRIVER_HOST="jupyter"
SPARK_DRIVER_MEMORY="2g"
SPARK_EXECUTOR_MEMORY="2g"
SPARK_EXECUTOR_CORES="4"
SPARK_SHUFFLE_PARTITIONS="32"

# ---- Análisis ---------------------------------------------------------------
TOP_N="3"
UMBRAL_MUNICIPIO_GRANDE="20000"
BENCH_REPEATS="3"

# ---- MapReduce (Hadoop Streaming) -------------------------------------------
MR_OUTPUT="/results/mitma/mr_streaming"
MR_RDD_OUTPUT="/results/mitma/mr_rdd"
MR_REDUCERS="2"

# ---- Machine Learning -------------------------------------------------------
ML_MUNICIPIO_COL="origen"
ML_TRAIN_FRACTION="0.8"
ML_SEED="42"

# ---- Desafío F3 (archivos pequeños) ----------------------------------------
SMALLFILES_PATH="/tmp/mitma_smallfiles"
